# ========================================================
# Procucev AI Speech to Text - Environment Variables Example
# Copy this file to .env before starting the services
# ========================================================

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=speech_to_text
DB_USER=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/speech_to_text

# --- Spring Boot Backend Configuration ---
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Speech Recognition Providers ---
# Options: deepgram, mock, whisper
SPEECH_PROVIDER=deepgram

# Deepgram Nova-2 API Key (Sign up at https://console.deepgram.com for free $200 credits)
# Required for real-time WebSocket streaming of Hindi-English multilingual audio
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=hi
DEEPGRAM_DETECT_LANGUAGE=true

# Optional Google Gemini Live API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Self-Hosted Whisper Streaming Server WebSocket URL
WHISPER_WS_URL=ws://localhost:9090

# --- Frontend Configuration ---
VITE_BACKEND_URL=http://localhost:8080
